apiVersion: apiregistration.k8s.io/v1
kind: APIService
metadata:
  name: v1beta1.external.metrics.k8s.io
spec:
  service:
    name: custom-metric-adapter-svc
    namespace: custom-metrics
    port: 443
  group: external.metrics.k8s.io
  version: v1beta1
  insecureSkipTLSVerify: true  # 測試環境可略過；正式環境請填 caBundle 欄位
  groupPriorityMinimum: 100
  versionPriority: 100
